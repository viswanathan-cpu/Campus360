# GEMINI_API_KEY: Required for Gemini AI API calls (AI Complaint Inspector).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_ACCESS_SECRET: Secret key used to sign short-lived JWT access tokens.
JWT_ACCESS_SECRET="campus360_enterprise_jwt_access_secret_2026"

# JWT_REFRESH_SECRET: Secret key used to sign rotating refresh tokens.
JWT_REFRESH_SECRET="campus360_enterprise_jwt_refresh_secret_2026"

# REDIS_URL: Redis connection URI for session & refresh token rotation cluster.
REDIS_URL="redis://localhost:6379"

# DATABASE_URL: Prisma database connection string for Phase 3/5B persistence.
DATABASE_URL="postgresql://campus360:campus360@localhost:5432/campus360?schema=public"
